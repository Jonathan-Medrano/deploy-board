# deploy-board - copia este archivo a .env y completalo. El .env NO se commitea.
# El instalador ya te lo copio: solo falta pegar las claves.
#
# No hace falta tener ningun otro repositorio clonado. Todo lo que el sistema necesita
# leer lo lee de Azure DevOps y de las bases de dev/stage.

# ============================================================
#  1. AZURE DEVOPS  (pedile estos datos al equipo)
# ============================================================
AZURE_ORG_URL=https://agenciap.visualstudio.com
AZURE_PROJECT=Fidel

# Token personal de Azure, con permiso de LECTURA de work items y de codigo.
# Se saca en: Azure DevOps > User settings > Personal access tokens.
AZURE_PAT=

# ============================================================
#  2. BASES QUE SE CONSULTAN  (solo lectura; produccion NUNCA)
# ============================================================
# Pedile estas tres al equipo. Sin ellas el sistema abre pero no puede medir nada.
SQL_SERVER=
SQL_USER=
SQL_PASSWORD=

# ============================================================
#  3. QUE SPRINT SE MIDE
# ============================================================
# La iteracion, tal cual figura en Azure.
DEPLOY_BOARD_ITERACION=Fidel\2026\2026 Septiembre 2

# La carpeta del sprint dentro de Api/DB_Migrations. Se lee de Azure, no del disco.
DEPLOY_BOARD_SPRINT=Sprint_2026_09_02

DEPLOY_BOARD_AMBIENTES=dev,stage
DEPLOY_BOARD_DESTINO=stage

# De donde se leen los .sql del repo. Cambialo solo si se mudan de lugar.
# DEPLOY_BOARD_REPO_SCRIPTS=Api.Net
# DEPLOY_BOARD_RAMA_SCRIPTS=dev

# Rama que el equipo trata como "ya corrio en produccion" para el badge "Ya en rama MAIN".
# NO es master: los PR de StageToMain van a main, master no es el destino de promocion.
# DEPLOY_BOARD_RAMA_MAIN=main

# ============================================================
#  4. QUIEN EJECUTA QUE, POR AMBIENTE
# ============================================================
# En un pase dev<->stage, lo que falte en el destino lo corre el "Encargado de ejecutar scripts":
# es un rol fijo, no hace falta configurarlo.
# En produccion lo corren los encargados del deploy, nunca el dev que escribio el script.
RESPONSABLE_PRODUCCION=

# ============================================================
#  5. OPCIONALES
# ============================================================
# Las marcas de "ya subido a main" se guardan aca. Apuntalo a una carpeta COMPARTIDA
# para que lo que marca uno lo vean todos. Por defecto: deploy-board/estado/
# DEPLOY_BOARD_ESTADO=\\servidor\deploy-board\estado

DEPLOY_BOARD_PORT=4700

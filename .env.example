# deploy-board — copia este archivo a .env y completalo. El .env NO se commitea.
#
# Si ya tenes andando el task runner, la mayoria de esto ya esta en taskrunner/.env y se lee
# solo: `npm start` carga ../taskrunner/.env ANTES que este archivo, asi que aca solo hace
# falta lo que quieras pisar.

# --- Azure DevOps (lectura) ---
AZURE_ORG_URL=https://agenciap.visualstudio.com
AZURE_PROJECT=Fidel
AZURE_PAT=

# --- Bases que se sondean (SOLO lectura, y produccion NUNCA) ---
# Si no las ponés, se cae al Web.config del Api.Net. Lo correcto es un login de solo lectura.
SQL_SERVER=
SQL_USER=
SQL_PASSWORD=

# Donde esta el Api.Net, para encontrar DB_Migrations y el Web.config.
API_NET_DIR=../Api.Net

# --- Que sprint se mide ---
DEPLOY_BOARD_ITERACION=Fidel\2026\2026 Septiembre 2
DEPLOY_BOARD_SPRINT=Sprint_2026_09_01
DEPLOY_BOARD_AMBIENTES=dev,stage
DEPLOY_BOARD_DESTINO=stage

# --- Quien ejecuta que, por ambiente ---
# Sin esto los desvios salen sin nombre. Nunca se inventa uno.
RESPONSABLE_PROMOCION=
RESPONSABLE_PRODUCCION=

# --- Donde viven las marcas de main y los ignorados ---
# Por defecto: deploy-board/estado/ (local, de cada uno).
# Apuntalo a una carpeta COMPARTIDA para que una marca de Juani la vea todo el equipo.
# DEPLOY_BOARD_ESTADO=\\servidor\deploy-board\estado

# Puerto del tablero. 4600 es el task runner; 4700 no pisa a nadie.
DEPLOY_BOARD_PORT=4700
